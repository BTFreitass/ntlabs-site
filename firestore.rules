rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Única conta com acesso ao painel (a mesma de public/firebase-config.js)
    function admin() {
      return request.auth != null
        && request.auth.token.email == 'brunotavaresdefreitas@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function txt(v, n) { return v is string && v.size() <= n; }

    // Público lê; só o painel escreve
    match /site/{doc}      { allow read: if true; allow write: if admin(); }
    match /projetos/{id}   { allow read: if true; allow write: if admin(); }
    match /imgs/{id}       { allow read: if true; allow write: if admin(); }

    // Só o painel
    match /clientes/{id}   { allow read, write: if admin(); }

    // Formulário de orçamento: qualquer pessoa cria, só o painel lê e altera
    match /pedidos/{id} {
      allow read, update, delete: if admin();
      allow create: if request.resource.data.keys().hasOnly(['nome','whats','negocio','segmento','tipo','estilo','recursos','logo','dominio','orcamento','prazo','refs','msg','status','t'])
        && txt(request.resource.data.nome, 120) && request.resource.data.nome.size() > 0
        && txt(request.resource.data.whats, 40) && request.resource.data.whats.size() >= 10
        && txt(request.resource.data.negocio, 160) && request.resource.data.negocio.size() > 0
        && txt(request.resource.data.get('segmento', ''), 80)
        && txt(request.resource.data.get('tipo', ''), 80)
        && txt(request.resource.data.get('estilo', ''), 80)
        && request.resource.data.get('recursos', []) is list && request.resource.data.get('recursos', []).size() <= 12
        && txt(request.resource.data.get('logo', ''), 30)
        && txt(request.resource.data.get('dominio', ''), 30)
        && txt(request.resource.data.get('orcamento', ''), 40)
        && txt(request.resource.data.get('prazo', ''), 40)
        && txt(request.resource.data.get('refs', ''), 500)
        && txt(request.resource.data.get('msg', ''), 2000)
        && request.resource.data.status == 'novo'
        && request.resource.data.t is number;
    }

    // Contador de visitas: qualquer pessoa cria uma visita, só o painel lê
    match /visitas/{id} {
      allow read: if admin();
      allow create: if request.resource.data.keys().hasOnly(['dia','cel','origem','t'])
        && request.resource.data.dia is string && request.resource.data.dia.size() == 10
        && request.resource.data.cel is bool
        && request.resource.data.origem in ['link', 'direto']
        && request.resource.data.t is number;
    }
  }
}
